# Transbank WebPay Plus
# integration = sandbox (claves de prueba incluidas por defecto)
# production  = requiere WEBPAY_COMMERCE_CODE y WEBPAY_API_KEY reales
WEBPAY_ENV=integration
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_KEY=
# PUBLIC_SITE_URL=https://dropshipchile.pages.dev

# Flow.cl
# sandbox    = https://sandbox.flow.cl (crea cuenta de pruebas y copia tus claves)
# production = claves reales de https://www.flow.cl
FLOW_ENV=sandbox
# FLOW_API_KEY=
# FLOW_SECRET_KEY=
