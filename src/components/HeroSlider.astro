---
import { categories, products } from '../data/products';

const topByCat = categories.map((c) => {
  const list = products.filter((p) => p.category === c.id).sort((a, b) => b.sales - a.sales);
  return {
    ...c,
    product: list[0],
    image: c.image || list[0]?.image,
  };
});

const slides = [
  {
    id: 'welcome',
    type: 'brand' as const,
    eyebrow: 'kadmiel.cl',
    title: 'KADMIEL',
    subtitle: 'Elegancia · Calidad · Envío a Chile',
    cta: 'Explorar catálogo',
    href: '#categorias',
  },
  ...topByCat.slice(0, 5).map((c) => ({
    id: c.id,
    type: 'photo' as const,
    eyebrow: c.name,
    title: c.product?.name || c.name,
    subtitle: c.description,
    cta: `Ver ${c.name.split(' ')[0]}`,
    href: `/categoria/${c.slug}`,
    image: c.image,
  })),
];
---
<section class="hero-slider relative w-full overflow-hidden bg-black" aria-roledescription="carrusel" aria-label="Destacados Kadmiel">
  <div class="hero-track relative h-[min(78vh,640px)] md:h-[min(82vh,700px)]">
    {slides.map((slide, i) => (
      <article
        class:list={['hero-slide absolute inset-0', i === 0 && 'is-active']}
        data-index={i}
        aria-hidden={i !== 0}
      >
        {slide.type === 'brand' ? (
          <div class="absolute inset-0 bg-black">
            <!-- soft gold glow, no photo -->
            <div class="absolute inset-0 hero-brand-glow" aria-hidden="true"></div>
            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(212,175,55,0.12)_0%,transparent_55%)]"></div>
          </div>
        ) : (
          <div class="absolute inset-0 overflow-hidden">
            <img
              src={slide.image}
              alt=""
              class="hero-bg-img absolute inset-0 h-full w-full object-cover"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/55 to-black/40"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/40"></div>
          </div>
        )}

        <div class="relative z-10 h-full max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-center md:justify-start">
          <div class:list={['hero-content text-white', slide.type === 'brand' && 'text-center md:text-left w-full']}>
            {slide.type === 'brand' ? (
              <>
                <p class="hero-eyebrow text-amber-400/90 font-medium tracking-[0.35em] uppercase text-xs md:text-sm mb-4 md:mb-6">
                  {slide.eyebrow}
                </p>
                <h1 class="hero-brand-title mb-4 md:mb-6">
                  {slide.title}
                </h1>
                <p class="hero-sub text-base md:text-xl text-white/75 mb-8 md:mb-10 max-w-lg mx-auto md:mx-0 tracking-wide">
                  {slide.subtitle}
                </p>
              </>
            ) : (
              <>
                <p class="hero-eyebrow text-amber-400 font-semibold tracking-[0.2em] uppercase text-xs md:text-sm mb-3">
                  {slide.eyebrow}
                </p>
                <h2 class="hero-title text-3xl sm:text-4xl md:text-5xl font-bold leading-tight mb-4 max-w-xl">
                  {slide.title}
                </h2>
                <p class="hero-sub text-base md:text-lg text-gray-200 mb-8 max-w-md">
                  {slide.subtitle}
                </p>
              </>
            )}
            <div class:list={['hero-cta flex flex-wrap gap-3', slide.type === 'brand' && 'justify-center md:justify-start']}>
              <a href={slide.href} class="btn-gold">
                {slide.cta}
              </a>
              <a href="#top-ventas" class="btn-ghost-gold">
                Top ventas
              </a>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>

  <button type="button" class="hero-nav hero-prev" aria-label="Slide anterior">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
  </button>
  <button type="button" class="hero-nav hero-next" aria-label="Slide siguiente">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </button>

  <div class="absolute bottom-0 left-0 right-0 z-20">
    <div class="hero-progress h-1 bg-white/10">
      <div class="hero-progress-bar h-full bg-amber-400 origin-left"></div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
      <div class="hero-dots flex gap-2" role="tablist" aria-label="Slides">
        {slides.map((_, i) => (
          <button
            type="button"
            class:list={['hero-dot', i === 0 && 'is-active']}
            data-index={i}
            role="tab"
            aria-selected={i === 0}
            aria-label={`Ir al slide ${i + 1}`}
          />
        ))}
      </div>
      <p class="text-white/50 text-xs tabular-nums hidden sm:block tracking-widest">
        <span class="hero-counter text-amber-400">01</span> / {String(slides.length).padStart(2, '0')}
      </p>
    </div>
  </div>
</section>

<style>
  .hero-brand-title {
    font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(3.5rem, 14vw, 8.5rem);
    line-height: 0.95;
    letter-spacing: 0.22em;
    text-indent: 0.22em;
    background: linear-gradient(
      165deg,
      #ffffff 0%,
      #fff8e7 18%,
      #e8d5a3 38%,
      #d4af37 52%,
      #f5e6c8 68%,
      #ffffff 100%
    );
    background-size: 180% 180%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: gold-shimmer 8s ease-in-out infinite;
    filter: drop-shadow(0 0 40px rgba(212, 175, 55, 0.25));
  }
  @keyframes gold-shimmer {
    0%, 100% { background-position: 0% 40%; }
    50% { background-position: 100% 60%; }
  }
  .hero-brand-glow {
    background:
      radial-gradient(ellipse 80% 50% at 50% 45%, rgba(212, 175, 55, 0.18), transparent 70%),
      radial-gradient(circle at 20% 80%, rgba(255, 255, 255, 0.04), transparent 40%),
      radial-gradient(circle at 80% 20%, rgba(212, 175, 55, 0.08), transparent 35%);
  }
  .btn-gold {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: #0a0a0a;
    background: linear-gradient(135deg, #f5e6c8, #d4af37 45%, #c9a227 70%, #f0d78c);
    box-shadow: 0 4px 24px rgba(212, 175, 55, 0.35);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .btn-gold:hover {
    transform: scale(1.03);
    box-shadow: 0 6px 28px rgba(212, 175, 55, 0.5);
  }
  .btn-ghost-gold {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: #f5e6c8;
    border: 1px solid rgba(212, 175, 55, 0.45);
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(8px);
    transition: background 0.2s, border-color 0.2s;
  }
  .btn-ghost-gold:hover {
    background: rgba(212, 175, 55, 0.12);
    border-color: rgba(212, 175, 55, 0.7);
  }

  .hero-slide {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.7s ease, visibility 0.7s;
  }
  .hero-slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 1;
  }
  .hero-slide.is-active .hero-bg-img {
    animation: kenburns 7.5s ease-out forwards;
  }
  .hero-slide.is-active .hero-eyebrow,
  .hero-slide.is-active .hero-title,
  .hero-slide.is-active .hero-brand-title,
  .hero-slide.is-active .hero-sub,
  .hero-slide.is-active .hero-cta {
    animation: rise 0.8s both;
  }
  .hero-slide.is-active .hero-eyebrow { animation-delay: 0.08s; }
  .hero-slide.is-active .hero-title,
  .hero-slide.is-active .hero-brand-title { animation-delay: 0.18s; }
  .hero-slide.is-active .hero-sub { animation-delay: 0.3s; }
  .hero-slide.is-active .hero-cta { animation-delay: 0.4s; }

  @keyframes kenburns {
    from { transform: scale(1.12); }
    to { transform: scale(1) translate3d(0, -1%, 0); }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(212, 175, 55, 0.35);
    color: #f5e6c8;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(8px);
    transition: background 0.2s, transform 0.2s, color 0.2s;
  }
  .hero-nav:hover {
    background: #d4af37;
    color: #0a0a0a;
    transform: translateY(-50%) scale(1.05);
  }
  .hero-prev { left: 0.75rem; }
  .hero-next { right: 0.75rem; }
  @media (min-width: 768px) {
    .hero-prev { left: 1.5rem; }
    .hero-next { right: 1.5rem; }
  }
  .hero-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.3);
    transition: width 0.35s ease, background 0.25s;
  }
  .hero-dot.is-active {
    width: 1.75rem;
    background: #d4af37;
  }
  .hero-progress-bar {
    width: 100%;
    transform: scaleX(0);
  }
  .hero-progress-bar.is-running {
    animation: progress linear forwards;
  }
  @keyframes progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
</style>

<script>
  function initHeroSlider() {
    const root = document.querySelector('.hero-slider');
    if (!root || (root as HTMLElement).dataset.ready) return;
    (root as HTMLElement).dataset.ready = '1';

    const slides = Array.from(root.querySelectorAll<HTMLElement>('.hero-slide'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.hero-dot'));
    const bar = root.querySelector<HTMLElement>('.hero-progress-bar');
    const counter = root.querySelector('.hero-counter');
    const prev = root.querySelector('.hero-prev');
    const next = root.querySelector('.hero-next');
    const DURATION = 6500;
    let index = 0;
    let timer: ReturnType<typeof setTimeout> | null = null;
    let paused = false;

    function go(to: number) {
      slides[index]?.classList.remove('is-active');
      slides[index]?.setAttribute('aria-hidden', 'true');
      dots[index]?.classList.remove('is-active');
      dots[index]?.setAttribute('aria-selected', 'false');
      index = (to + slides.length) % slides.length;
      slides[index]?.classList.add('is-active');
      slides[index]?.setAttribute('aria-hidden', 'false');
      dots[index]?.classList.add('is-active');
      dots[index]?.setAttribute('aria-selected', 'true');
      if (counter) counter.textContent = String(index + 1).padStart(2, '0');
      restartProgress();
    }

    function restartProgress() {
      if (!bar) return;
      bar.classList.remove('is-running');
      bar.style.animationDuration = '';
      void bar.offsetWidth;
      if (!paused) {
        bar.style.animationDuration = `${DURATION}ms`;
        bar.classList.add('is-running');
      }
    }

    function schedule() {
      if (timer) clearTimeout(timer);
      if (paused) return;
      timer = setTimeout(() => go(index + 1), DURATION);
      restartProgress();
    }

    function pause() {
      paused = true;
      if (timer) clearTimeout(timer);
      bar?.classList.remove('is-running');
    }
    function resume() {
      paused = false;
      schedule();
    }

    prev?.addEventListener('click', () => { go(index - 1); schedule(); });
    next?.addEventListener('click', () => { go(index + 1); schedule(); });
    dots.forEach((dot, i) => dot.addEventListener('click', () => { go(i); schedule(); }));

    root.addEventListener('mouseenter', pause);
    root.addEventListener('mouseleave', resume);
    root.addEventListener('focusin', pause);
    root.addEventListener('focusout', resume);

    let startX = 0;
    root.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; pause(); }, { passive: true });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) go(dx < 0 ? index + 1 : index - 1);
      resume();
    }, { passive: true });

    schedule();
  }
  initHeroSlider();
  document.addEventListener('astro:page-load', initHeroSlider);
</script>
