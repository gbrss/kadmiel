---
import { formatPrice, type Product } from '../data/products';
interface Props { product: Product; }
const { product } = Astro.props;
const discount = product.originalPrice ? Math.round((1 - product.price / product.originalPrice) * 100) : 0;
---
<a href={`/producto/${product.slug}`} class="card group block">
  <div class="relative aspect-square bg-ink-800 overflow-hidden">
    <img
      src={product.image}
      alt={product.name}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    {discount > 0 && (
      <span class="absolute top-2 left-2 bg-gradient-to-r from-amber-200 to-amber-500 text-black text-xs font-bold px-2.5 py-1 rounded-full shadow">
        -{discount}%
      </span>
    )}
  </div>
  <div class="p-4">
    <h3 class="font-medium text-sm text-stone-100 line-clamp-2 mb-2 group-hover:text-amber-300 transition-colors">
      {product.name}
    </h3>
    <div class="flex items-center gap-1 mb-2">
      <span class="text-amber-400 text-sm">{'★'.repeat(Math.round(product.rating))}</span>
      <span class="text-xs text-stone-500">({product.reviews.toLocaleString('es-CL')})</span>
    </div>
    <div class="flex items-baseline gap-2 flex-wrap">
      <span class="font-bold text-amber-400">{formatPrice(product.price)}</span>
      {product.originalPrice && (
        <span class="text-xs text-stone-500 line-through">{formatPrice(product.originalPrice)}</span>
      )}
    </div>
  </div>
</a>
