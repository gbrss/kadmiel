---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Checkout — kadmiel.cl">
  <Header />
  <main class="max-w-2xl mx-auto px-4 sm:px-6 py-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Finalizar compra</h1>

    <div id="checkout-empty" class="hidden text-center py-12">
      <p class="text-gray-500 mb-4">No hay productos en el carrito</p>
      <a href="/" class="btn-primary">Volver a la tienda</a>
    </div>

    <div id="checkout-form" class="hidden space-y-6">
      <!-- Resumen -->
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h2 class="font-semibold text-gray-900 mb-4">Resumen del pedido</h2>
        <div id="order-summary" class="space-y-2 text-sm"></div>
        <div class="border-t border-gray-100 mt-4 pt-3 space-y-2 text-sm">
          <div class="flex justify-between text-gray-500">
            <span>Costo proveedor est. (60%)</span>
            <span id="order-cost">$0</span>
          </div>
          <div class="flex justify-between text-emerald-700 font-medium">
            <span>Comisión tienda 40%</span>
            <span id="order-commission">$0</span>
          </div>
          <div class="flex justify-between items-center pt-2 border-t border-gray-100">
            <span class="font-semibold text-base">Total a pagar</span>
            <span id="order-total" class="text-xl font-bold text-brand-700">$0</span>
          </div>
        </div>
      </div>

      <!-- Datos envío -->
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h2 class="font-semibold text-gray-900 mb-4">Datos de envío</h2>
        <form id="pay-form" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Nombre completo</label>
            <input type="text" name="name" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none" placeholder="Juan Pérez" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input type="email" name="email" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none" placeholder="juan@email.com" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Teléfono</label>
            <input type="tel" name="phone" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none" placeholder="+56 9 1234 5678" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Dirección</label>
            <input type="text" name="address" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none" placeholder="Calle, número, depto" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Ciudad</label>
              <input type="text" name="city" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none" placeholder="Santiago" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Región</label>
              <input type="text" name="region" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none" placeholder="Metropolitana" />
            </div>
          </div>

          <!-- Método de pago -->
          <div class="pt-4 border-t border-gray-100">
            <h3 class="font-semibold text-gray-900 mb-3">Método de pago</h3>
            <label class="flex items-center gap-3 p-4 rounded-xl border-2 border-brand-500 bg-brand-50 cursor-pointer">
              <input type="radio" name="payment" value="webpay" checked class="text-brand-600" />
              <div class="flex-1">
                <div class="font-medium text-gray-900">WebPay Plus</div>
                <div class="text-xs text-gray-500">Tarjetas de crédito y débito · Transbank</div>
              </div>
              <span class="text-2xl" aria-hidden="true">💳</span>
            </label>
            <p class="mt-2 text-xs text-gray-500">
              Serás redirigido a la pasarela segura de Transbank. No almacenamos datos de tu tarjeta.
            </p>
            <div class="mt-3 p-3 rounded-lg bg-amber-50 border border-amber-200 text-xs text-amber-900">
              <strong>Modo integración (pruebas):</strong>
              Visa <code class="bg-white px-1 rounded">4051885600446623</code> · CVV <code class="bg-white px-1 rounded">123</code> ·
              RUT <code class="bg-white px-1 rounded">11.111.111-1</code> · clave <code class="bg-white px-1 rounded">123</code>
            </div>
          </div>

          <p id="pay-error" class="hidden text-sm text-red-600"></p>

          <button type="submit" id="pay-btn" class="btn-primary w-full py-3 text-base">
            Pagar con WebPay
          </button>
        </form>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const COMMISSION = 0.4;

  function fmt(n: number) {
    return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', minimumFractionDigits: 0 }).format(n);
  }

  function getCart(): { id: string; name: string; price: number; qty: number; image?: string }[] {
    try {
      return JSON.parse(localStorage.getItem('cart') || '[]');
    } catch {
      return [];
    }
  }

  function render() {
    const cart = getCart();
    const empty = document.getElementById('checkout-empty')!;
    const form = document.getElementById('checkout-form')!;

    if (!cart.length) {
      empty.classList.remove('hidden');
      form.classList.add('hidden');
      return;
    }

    empty.classList.add('hidden');
    form.classList.remove('hidden');

    const total = cart.reduce((s, i) => s + i.price * i.qty, 0);
    const commission = Math.round(total * COMMISSION);
    const cost = total - commission;

    const summary = document.getElementById('order-summary')!;
    summary.innerHTML = cart
      .map(
        (i) =>
          `<div class="flex justify-between gap-2"><span class="text-gray-700 truncate">${i.qty}× ${i.name}</span><span class="font-medium whitespace-nowrap">${fmt(i.price * i.qty)}</span></div>`
      )
      .join('');

    document.getElementById('order-cost')!.textContent = fmt(cost);
    document.getElementById('order-commission')!.textContent = fmt(commission);
    document.getElementById('order-total')!.textContent = fmt(total);
  }

  render();

  const payForm = document.getElementById('pay-form') as HTMLFormElement;
  payForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('pay-btn') as HTMLButtonElement;
    const errEl = document.getElementById('pay-error')!;
    errEl.classList.add('hidden');
    errEl.textContent = '';

    const cart = getCart();
    if (!cart.length) {
      errEl.textContent = 'El carrito está vacío';
      errEl.classList.remove('hidden');
      return;
    }

    const total = cart.reduce((s, i) => s + i.price * i.qty, 0);
    const buyOrder = `DS${Date.now()}`.slice(0, 26);
    const sessionId = `S${Date.now()}`.slice(0, 61);

    // Guardar datos de envío para referencia post-pago
    const fd = new FormData(payForm);
    try {
      sessionStorage.setItem(
        'checkout_shipping',
        JSON.stringify({
          name: fd.get('name'),
          email: fd.get('email'),
          phone: fd.get('phone'),
          address: fd.get('address'),
          city: fd.get('city'),
          region: fd.get('region'),
          buyOrder,
          items: cart,
          total,
        })
      );
    } catch {
      /* ignore */
    }

    btn.disabled = true;
    btn.textContent = 'Conectando con WebPay…';

    try {
      const res = await fetch('/api/webpay/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ amount: total, buyOrder, sessionId }),
      });

      const data = await res.json();

      if (!res.ok || !data.token || !data.url) {
        throw new Error(data.error || 'No se pudo iniciar el pago');
      }

      // Redirección POST a Transbank (formulario obligatorio)
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = data.url;
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'token_ws';
      input.value = data.token;
      form.appendChild(input);
      document.body.appendChild(form);
      form.submit();
    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : 'Error de conexión';
      errEl.textContent = message;
      errEl.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Pagar con WebPay';
    }
  });
</script>
